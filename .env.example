# Makerspace RAG - Environment Configuration
# Copy this file to .env and adjust values as needed

# ======================
# Database Configuration
# ======================
# For local database (same machine):
DB_HOST=localhost
DB_PORT=3306
DB_USER=makerspace
DB_PASSWORD=makerspace2024
DB_NAME=makerspace_rag

# For remote database (different machine):
# DB_HOST=192.168.1.100
# DB_PORT=3306
# DB_USER=makerspace
# DB_PASSWORD=makerspace2024
# DB_NAME=makerspace_rag

# Or use a full connection URI:
# DATABASE_URI=mysql+pymysql://user:password@host:port/database

# ======================
# Flask Configuration
# ======================
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=change-this-to-a-random-string-in-production

# ======================
# Admin Authentication
# ======================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=makerspace2024

# ======================
# Ollama / LLM Settings
# ======================
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=llama3
LLM_SMALL_MODEL=llama3.2:1b
EMBEDDING_MODEL=mxbai-embed-large

# ======================
# Search Settings
# ======================
USE_EMBEDDINGS=true
HYBRID_ALPHA=0.5

# ======================
# File Processing
# ======================
UPLOAD_FOLDER=uploads
MAX_CONTENT_MB=16
VAULT_FILE=vault.txt
KNOWLEDGE_DIR=knowledge
CHUNK_SIZE=1000
