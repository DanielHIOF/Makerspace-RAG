# Makerspace RAG - Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# Flask Configuration
# =============================================================================
FLASK_ENV=development
SECRET_KEY=generate-a-secure-random-key-here

# =============================================================================
# Database Configuration (MariaDB)
# =============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=makerspace
DB_PASSWORD=change-this-password
DB_NAME=makerspace_rag

# Full connection string (alternative to individual settings)
# DATABASE_URI=mysql+pymysql://makerspace:password@localhost:3306/makerspace_rag

# For RPI4 deployment, use Pi's IP address
# DB_HOST=192.168.1.100

# =============================================================================
# Admin Authentication
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# =============================================================================
# Ollama LLM Configuration
# =============================================================================
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=llama3
LLM_SMALL_MODEL=llama3.2:1b
EMBEDDING_MODEL=mxbai-embed-large

# =============================================================================
# Search Configuration
# =============================================================================
# Enable semantic embeddings for hybrid search (true/false)
USE_EMBEDDINGS=true

# Hybrid search alpha (0=TF-IDF only, 1=embeddings only, 0.5=balanced)
HYBRID_ALPHA=0.5

# =============================================================================
# Application Settings
# =============================================================================
UPLOAD_FOLDER=uploads
MAX_CONTENT_MB=16
VAULT_FILE=vault.txt
KNOWLEDGE_DIR=knowledge
CHUNK_SIZE=1000
